name: Nexus Build Omniversal CI

on:
  push:
    branches: [main, master, develop]
  pull_request:
    branches: [main, master]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Omni
        uses: omnicli/setup-action@v0.0.1
        with:
          version: latest
          up: true
          cache: true
          cache_write: true
          cache_check_hash: true
          cache_key_prefix: omni-v0

      - name: Setup Nimbus
        uses: renmy-solutions/setup-nimbus@v1.0.0
        with:
          version: latest

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi

      - name: Detect ecosystems
        run: python nexus-build.py detect --path .

      - name: Run build
        run: python nexus-build.py build --path . --ecosystem python-pip --mode local

      - name: Upload artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: nexus-build-output
          path: ~/nexus_build_omniversal/artifacts/
          retention-days: 7
          if-no-files-found: ignore
