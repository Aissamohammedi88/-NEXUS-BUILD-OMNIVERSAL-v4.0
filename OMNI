class DBManager:
SCHEMA = """
CREATE TABLE IF NOT EXISTS builds (
id TEXT PRIMARY KEY,
request_id TEXT,
ecosystem TEXT,
status TEXT,
started_at TEXT,
finished_at TEXT,
duration_sec REAL,
exit_code INTEGER,
cache_hit INTEGER,
security_findings INTEGER,
cost_usd REAL,
arch TEXT,
worker TEXT,
request_json TEXT,
stdout TEXT,
stderr TEXT
);
CREATE TABLE IF NOT EXISTS cache (
key TEXT PRIMARY KEY,
path TEXT,
size_bytes INTEGER,
created_at TEXT,
hits INTEGER DEFAULT 0,
last_hit TEXT
);
CREATE TABLE IF NOT EXISTS workers (
id TEXT PRIMARY KEY,
host TEXT,
port INTEGER,
arch TEXT,
cpus INTEGER,
memory_mb INTEGER,
state TEXT,
last_seen REAL,
jobs_done INTEGER DEFAULT 0
);
CREATE TABLE IF NOT EXISTS security_findings (
id TEXT PRIMARY KEY,
build_id TEXT,
severity TEXT,
kind TEXT,
file TEXT,
line INTEGER,
snippet TEXT,
recommendation TEXT
);
CREATE TABLE IF NOT EXISTS events (
id INTEGER PRIMARY KEY AUTOINCREMENT,
ts TEXT,
kind TEXT,
data TEXT
);
CREATE INDEX IF NOT EXISTS idx_builds_status ON builds(status);
CREATE INDEX IF NOT EXISTS idx_builds_ecosystem ON builds(ecosystem);
CREATE INDEX IF NOT EXISTS idx_findings_build ON security_findings(build_id);
CREATE INDEX IF NOT EXISTS idx_events_ts ON events(ts);
"""

def __init__(self, path: Path):
self.path = path
self.lock = threading.RLock()
self.conn = sqlite3.connect(str(path), check_same_thread=False, timeout=30)
self.conn.row_factory = sqlite3.Row
self._migrate()

def _migrate(self):
with self.lock:
self.conn.executescript(self.SCHEMA)
self.conn.commit()

def execute(self, sql: str, params: Tuple = ()) -> sqlite3.Cursor:
with self.lock:
cur = self.conn.execute(sql, params)
self.conn.commit()
return cur

def query(self, sql: str, params: Tuple = ()) -> List[sqlite3.Row]:
with self.lock:
return self.conn.execute(sql, params).fetchall()

def event(self, kind: str, data: Any):
self.execute(
"INSERT INTO events(ts, kind, data) VALUES(?,?,?)",
(datetime.datetime.now(datetime.timezone.utc).isoformat(), kind, json.dumps(data, default=str)),
)

def save_build(self, req: BuildRequest, res: BuildResult):
self.execute(
"""INSERT OR REPLACE INTO builds
(id, request_id, ecosystem, status, started_at, finished_at, duration_sec,
exit_code, cache_hit, security_findings, cost_usd, arch, worker,
request_json, stdout, stderr)
VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
(res.id, res.request_id, res.ecosystem, res.status, res.started_at, res.finished_at,
res.duration_sec, res.exit_code, 1 if res.cache_hit else 0, res.security_findings,
res.cost_usd, res.arch, res.worker, json.dumps(asdict(req), default=str),
res.stdout[-200000:], res.stderr[-200000:]),
)

def get_build(self, build_id: str) -> Optional[Dict[str, Any]]:
rows = self.query("SELECT * FROM builds WHERE id = ?", (build_id,))
return dict(rows[0]) if rows else None

def list_builds(self, limit: int = 100) -> List[Dict[str, Any]]:
rows = self.query("SELECT id, ecosystem, status, started_at, duration_sec, cache_hit, arch, worker FROM builds ORDER BY started_at DESC LIMIT ?", (limit,))
return [dict(r) for r in rows]

def cache_get(self, key: str) -> Optional[Dict[str, Any]]:
rows = self.query("SELECT * FROM cache WHERE key = ?", (key,))
if not rows:
return None
self.execute("UPDATE cache SET hits = hits + 1, last_hit = ? WHERE key = ?",
(datetime.datetime.now(datetime.timezone.utc).isoformat(), key))
return dict(rows[0])

def cache_put(self, key: str, path: str, size: int):
self.execute(
"INSERT OR REPLACE INTO cache(key, path, size_bytes, created_at, hits, last_hit) VALUES(?,?,?,?,0,?)",
(key, path, size, datetime.datetime.now(datetime.timezone.utc).isoformat(), ""),
)

def cache_stats(self) -> Dict[str, Any]:
rows = self.query("SELECT COUNT(*) AS n, SUM(size_bytes) AS s, SUM(hits) AS h FROM cache")
if not rows:
return {"entries": 0, "size_bytes": 0, "hits": 0}
r = rows[0]
return {"entries": r["n"] or 0, "size_bytes": r["s"] or 0, "hits": r["h"] or 0}

def register_worker(self, w: Worker):
self.execute(
"""INSERT OR REPLACE INTO workers(id, host, port, arch, cpus, memory_mb, state, last_seen, jobs_done)
VALUES (?,?,?,?,?,?,?,?,?)""",
(w.id, w.host, w.port, w.arch, w.cpus, w.memory_mb, w.state, w.last_seen, w.jobs_done),
)

def list_workers(self) -> List[Dict[str, Any]]:
rows = self.query("SELECT * FROM workers ORDER BY last_seen DESC")
return [dict(r) for r in rows]

def save_finding(self, f: SecurityFinding):
self.execute(
"""INSERT OR REPLACE INTO security_findings(id, build_id, severity, kind, file, line, snippet, recommendation)
VALUES (?,?,?,?,?,?,?,?)""",
(f.id, f.build_id, f.severity, f.kind, f.file, f.line, f.snippet, f.recommendation),
)

def findings_for_build(self, build_id: str) -> List[Dict[str, Any]]:
rows = self.query("SELECT * FROM security_findings WHERE build_id = ?", (build_id,))
return [dict(r) for r in rows]

def stats(self) -> Dict[str, Any]:
total = self.query("SELECT COUNT(*) AS n FROM builds")[0]["n"]
success = self.query("SELECT COUNT(*) AS n FROM builds WHERE status = 'success'")[0]["n"]
failed = self.query("SELECT COUNT(*) AS n FROM builds WHERE status = 'failed'")[0]["n"]
cached = self.query("SELECT COUNT(*) AS n FROM builds WHERE cache_hit = 1")[0]["n"]
avg = self.query("SELECT AVG(duration_sec) AS d FROM builds WHERE status='success'")[0]["d"] or 0.0
return {
"builds_total": total,
"builds_success": success,
"builds_failed": failed,
"builds_cached": cached,
"avg_duration_sec": round(avg, 2),
}

def close(self):
with self.lock:
self.conn.close()


