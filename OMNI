class EcosystemRegistry:
"""Registre centralisé de tous les écosystèmes supportés."""

ECOSYSTEMS: Dict[str, EcosystemInfo] = {}

@classmethod
def register(cls, info: EcosystemInfo) -> None:
cls.ECOSYSTEMS[info.key] = info

@classmethod
def get(cls, key: str) -> Optional[EcosystemInfo]:
return cls.ECOSYSTEMS.get(key)

@classmethod
def all_keys(cls) -> List[str]:
return sorted(cls.ECOSYSTEMS.keys())

@classmethod
def detect(cls, project_path: str) -> List[str]:
"""Détecte les écosystèmes présents dans un projet."""
found: Set[str] = set()
p = Path(project_path)
if not p.exists():
return []
try:
files = {f.name for f in p.iterdir() if f.is_file()}
except OSError:
return []
for key, info in cls.ECOSYSTEMS.items():
for marker in info.detect_files:
if marker in files:
found.add(key)
break
return sorted(found)


