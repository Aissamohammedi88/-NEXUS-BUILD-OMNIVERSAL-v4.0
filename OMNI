START_TS = time.time()


def cli_serve(args):
global DB, CACHE, POOL, ENGINE, START_TS
DB = DBManager(DB_PATH)
CACHE = CacheStore(CACHE_DIR)
POOL = WorkerPool(min_workers=args.min_workers, max_workers=args.max_workers)
ENGINE = BuildEngine()
