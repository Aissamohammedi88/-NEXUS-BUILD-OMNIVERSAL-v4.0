def main():
ap = argparse.ArgumentParser(description="Nexus Build Omniversal v" + VERSION)
sub = ap.add_subparsers(dest="cmd", required=True)

s1 = sub.add_parser("serve", help="Lance le serveur UI + API")
s1.add_argument("--host", default=HOST_DEFAULT)
s1.add_argument("--port", type=int, default=PORT_DEFAULT)
