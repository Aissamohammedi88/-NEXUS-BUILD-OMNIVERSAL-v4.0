class WorkerPool:
"""Pool local de workers simulant un réseau distribué."""

def __init__(self, min_workers: int = 2, max_workers: int = 16):
self.lock = threading.RLock()
self.workers: Dict[str, Worker] = {}
self.min_workers = min_workers
self.max_workers = max_workers
self.executor = ThreadPoolExecutor(max_workers=max_workers)
for _ in range(min_workers):
self.add_worker()

def add_worker(self, arch: str = Architecture.X86_64.value) -> Worker:
with self.lock:
if len(self.workers) >= self.max_workers:
return next(iter(self.workers.values()))
wid = str(uuid.uuid4())[:8]
w = Worker(
id=wid,
host="127.0.0.1",
port=0,
arch=arch,
cpus=os.cpu_count() or 1,
memory_mb=4096,
state="idle",
last_seen=time.time(),
jobs_done=0,
)
self.workers[wid] = w
DB.register_worker(w)
logl("worker_added", id=wid, arch=arch)
return w

def remove_worker(self, wid: str) -> bool:
with self.lock:
if wid in self.workers and len(self.workers) > self.min_workers:
del self.workers[wid]
return True
return False

def pick(self) -> Optional[Worker]:
with self.lock:
candidates = [w for w in self.workers.values() if w.state == "idle"]
if not candidates:
candidates = list(self.workers.values())
if not candidates:
return None
candidates.sort(key=lambda w: w.jobs_done)
return candidates[0]

def auto_scale(self, load: int):
with self.lock:
target = max(self.min_workers, min(self.max_workers, load + self.min_workers))
while len(self.workers) < target:
self.add_worker()
while len(self.workers) > target and len(self.workers) > self.min_workers:
wid = next(iter(self.workers.keys()))
self.remove_worker(wid)

def list_workers(self) -> List[Worker]:
with self.lock:
return list(self.workers.values())

def submit(self, fn: Callable, *args, **kwargs) -> concurrent.futures.Future:
return self.executor.submit(fn, *args, **kwargs)

def shutdown(self):
self.executor.shutdown(wait=False)


POOL: WorkerPool = None


