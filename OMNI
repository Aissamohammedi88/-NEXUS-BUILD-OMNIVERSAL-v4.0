class CacheStore:
"""Cache content-addressed pour artefacts de build."""

def __init__(self, cache_dir: Path):
self.dir = cache_dir
self.dir.mkdir(parents=True, exist_ok=True)
self.lock = threading.RLock()

def key_for(self, project_path: str, ecosystem: str, extra: str = "") -> str:
h = hashlib.sha256()
p = Path(project_path)
if p.is_dir():
files = sorted([f for f in p.rglob("*") if f.is_file()])
for f in files[:2000]:
try:
rel = str(f.relative_to(p))
stat = f.stat()
h.update(rel.encode())
h.update(str(stat.st_size).encode())
h.update(str(int(stat.st_mtime)).encode())
except OSError:
continue
h.update(ecosystem.encode())
h.update(extra.encode())
return h.hexdigest()[:32]

def lookup(self, key: str) -> Optional[str]:
with self.lock:
r = DB.cache_get(key)
if not r:
return None
path = Path(r["path"])
if path.exists():
return str(path)
return None

def store(self, key: str, source_path: str) -> str:
with self.lock:
src = Path(source_path)
if not src.exists():
return ""
dst = self.dir / key
dst.mkdir(parents=True, exist_ok=True)
size = 0
if src.is_dir():
for f in src.rglob("*"):
if f.is_file():
rel = f.relative_to(src)
target = dst / rel
target.parent.mkdir(parents=True, exist_ok=True)
try:
shutil.copy2(f, target)
size += target.stat().st_size
except OSError:
continue
else:
target = dst / src.name
shutil.copy2(src, target)
size = target.stat().st_size
DB.cache_put(key, str(dst), size)
return str(dst)

def clean(self, max_age_days: int = 30) -> int:
cutoff = time.time() - max_age_days * 86400
removed = 0
with self.lock:
for entry in self.dir.iterdir():
try:
if entry.stat().st_mtime < cutoff:
shutil.rmtree(entry, ignore_errors=True)
removed += 1
except OSError:
continue
return removed


