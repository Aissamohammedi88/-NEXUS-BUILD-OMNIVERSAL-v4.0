class BuildEngine:
"""Coeur d'orchestration."""

def __init__(self):
self.lock = threading.RLock()
self.results: Dict[str, BuildResult] = {}
self.futures: Dict[str, concurrent.futures.Future] = {}
self.stop = threading.Event()

def _env_for(self, req: BuildRequest) -> Dict[str, str]:
env = os.environ.copy()
env.update(req.env or {})
env["NEXUS_BUILD_ID"] = req.id
env["NEXUS_ARCH"] = req.arch
env["NEXUS_MODE"] = req.mode
return env

def _run_cmd(self, cmd: List[str], cwd: str, env: Dict[str, str], timeout: int, verbose: bool) -> Tuple[int, str, str]:
try:
if verbose:
logl("run_cmd", cmd=cmd, cwd=cwd)
proc = subprocess.run(
cmd,
cwd=cwd,
env=env,
capture_output=True,
text=True,
timeout=timeout,
)
return proc.returncode, proc.stdout, proc.stderr
except subprocess.TimeoutExpired:
return 124, "", "TIMEOUT après " + str(timeout) + "s"
except FileNotFoundError as e:
return 127, "", "Commande introuvable: " + str(e)
except Exception as e:
return 1, "", "Erreur: " + str(e)

def _check_tool(self, cmd: List[str]) -> bool:
if not cmd:
return False
return shutil.which(cmd[0]) is not None

def build(self, req: BuildRequest) -> BuildResult:
started_at = datetime.datetime.now(datetime.timezone.utc).isoformat()
t0 = time.time()
eco = EcosystemRegistry.get(req.ecosystem)
if not eco:
return BuildResult(
id=req.id, request_id=req.id, status=BuildStatus.FAILED.value,
ecosystem=req.ecosystem, started_at=started_at, finished_at=started_at,
duration_sec=0.0, exit_code=1, stdout="",
stderr="Ecosystem inconnu: " + req.ecosystem,
artifacts=[], cache_hit=False, security_findings=0,
cost_usd=0.0, arch=req.arch, worker="none",
)

if not self._check_tool(eco.build_cmd):
# fallback : marquer comme SKIP mais non-crash
duration = time.time() - t0
res = BuildResult(
id=req.id, request_id=req.id, status=BuildStatus.FAILED.value,
ecosystem=req.ecosystem, started_at=started_at,
finished_at=datetime.datetime.now(datetime.timezone.utc).isoformat(),
duration_sec=round(duration, 3), exit_code=127, stdout="",
stderr="Outil requis introuvable: " + eco.build_cmd[0],
artifacts=[], cache_hit=False, security_findings=0,
cost_usd=CostOptimizer.estimate(req.mode, duration, req.arch),
arch=req.arch, worker="none",
)
DB.save_build(req, res)
DB.event("build_failed", {"id": req.id, "reason": "tool_missing"})
return res

# Cache lookup
cache_key = CACHE.key_for(req.project_path, req.ecosystem, json.dumps(req.env, sort_keys=True))
if req.cache:
hit = CACHE.lookup(cache_key)
if hit:
duration = time.time() - t0
res = BuildResult(
id=req.id, request_id=req.id, status=BuildStatus.CACHED.value,
ecosystem=req.ecosystem, started_at=started_at,
finished_at=datetime.datetime.now(datetime.timezone.utc).isoformat(),
duration_sec=round(duration, 3), exit_code=0,
stdout="Cache hit: " + cache_key, stderr="",
artifacts=[hit], cache_hit=True, security_findings=0,
cost_usd=0.0, arch=req.arch, worker="cache",
)
DB.save_build(req, res)
DB.event("build_cached", {"id": req.id, "key": cache_key})
logl("build_cache_hit", id=req.id, key=cache_key)
return res

# Pick worker
worker = POOL.pick() if POOL else None
worker_id = worker.id if worker else "local"
if worker:
worker.state = "busy"
worker.last_seen = time.time()

# Install deps
if eco.install_cmd and self._check_tool(eco.install_cmd):
rc, out, err = self._run_cmd(eco.install_cmd, req.project_path, self._env_for(req), req.timeout_sec, req.verbose)
if rc != 0:
logl("install_failed", id=req.id, rc=rc)

# Build
rc, out, err = self._run_cmd(eco.build_cmd, req.project_path, self._env_for(req), req.timeout_sec, req.verbose)
status = BuildStatus.SUCCESS.value if rc == 0 else BuildStatus.FAILED.value

# Security scan
findings: List[SecurityFinding] = []
if req.security_scan:
try:
findings = SEC.scan(req.id, req.project_path)
for f in findings:
DB.save_finding(f)
except Exception as e:
logl("security_scan_error", error=str(e))

# Artifacts detection
artifacts: List[str] = []
for pattern in ("dist/*", "target/*", "build/*", "bin/*", "out/*", "*.jar", "*.whl", "*.tgz", "*.zip"):
try:
for f in Path(req.project_path).glob(pattern):
if f.is_file():
artifacts.append(str(f))
except Exception:
pass

# Cache store on success
if rc == 0 and req.cache and artifacts:
try:
for a in artifacts[:10]:
CACHE.store(cache_key, a)
except Exception as e:
logl("cache_store_error", error=str(e))

if worker:
worker.state = "idle"
worker.jobs_done += 1
worker.last_seen = time.time()
DB.register_worker(worker)

duration = time.time() - t0
res = BuildResult(
id=req.id, request_id=req.id, status=status,
ecosystem=req.ecosystem, started_at=started_at,
finished_at=datetime.datetime.now(datetime.timezone.utc).isoformat(),
duration_sec=round(duration, 3), exit_code=rc,
stdout=out[-200000:], stderr=err[-200000:],
artifacts=artifacts, cache_hit=False,
security_findings=len(findings),
cost_usd=CostOptimizer.estimate(req.mode, duration, req.arch),
arch=req.arch, worker=worker_id,
)
DB.save_build(req, res)
DB.event("build_done", {"id": req.id, "status": status, "duration": duration})
logl("build_done", id=req.id, status=status, duration=round(duration, 3), worker=worker_id)
return res

def submit(self, req: BuildRequest) -> concurrent.futures.Future:
with self.lock:
fut = POOL.submit(self.build, req)
self.futures[req.id] = fut
return fut

def submit_batch(self, reqs: List[BuildRequest]) -> Dict[str, concurrent.futures.Future]:
out: Dict[str, concurrent.futures.Future] = {}
for r in reqs:
out[r.id] = self.submit(r)
POOL.auto_scale(len(reqs))
return out


ENGINE: BuildEngine = None


