class Handler(BaseHTTPRequestHandler):
server_version = "NexusOmniversal/" + VERSION

def log_message(self, *args):
pass

def _send(self, code: int, ctype: str, body: bytes):
try:
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
self.wfile.write(body)
except (BrokenPipeError, ConnectionResetError):
pass

def _json(self, code: int, obj: Any):
body = json.dumps(obj, ensure_ascii=False, default=str).encode("utf-8")
self._send(code, "application/json; charset=utf-8", body)

def _read_json(self) -> Dict[str, Any]:
try:
n = int(self.headers.get("Content-Length", 0))
if n == 0:
return {}
if n > 10 * 1024 * 1024:
return {}
return json.loads(self.rfile.read(n).decode("utf-8"))
except Exception:
return {}

def do_OPTIONS(self):
self.send_response(200)
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
self.send_header("Access-Control-Allow-Headers", "Content-Type")
self.end_headers()

def do_GET(self):
u = urllib.parse.urlparse(self.path)
p = u.path
if p in ("/", "/index.html", "/ui"):
return self._send(200, "text/html; charset=utf-8", HTML_UI.encode("utf-8"))
if p == "/api/v1/health":
return self._json(200, {"status": "ok", "version": VERSION, "build": BUILD, "protocol": PROTOCOL})
if p == "/api/v1/ecosystems":
return self._json(200, {"ecosystems": [asdict(e) for e in EcosystemRegistry.ECOSYSTEMS.values()]})
if p == "/api/v1/status":
s = DB.stats()
workers = [asdict(w) for w in POOL.list_workers()]
recent = DB.list_builds(limit=30)
return self._json(200, {
"version": VERSION,
"build": BUILD,
"uptime_sec": int(time.time() - START_TS),
"stats": s,
"workers": workers,
"recent_builds": recent,
"cache": DB.cache_stats(),
"ecosystems_count": len(EcosystemRegistry.ECOSYSTEMS),
})
if p == "/api/v1/builds":
return self._json(200, {"builds": DB.list_builds(limit=200)})
if p.startswith("/api/v1/builds/"):
bid = p.rsplit("/", 1)[-1]
b = DB.get_build(bid)
if not b:
return self._json(404, {"error": "not_found"})
return self._json(200, b)
if p == "/api/v1/workers":
return self._json(200, {"workers": [asdict(w) for w in POOL.list_workers()]})
if p == "/api/v1/metrics":
return self._json(200, {
"stats": DB.stats(),
"cache": DB.cache_stats(),
"workers": len(POOL.list_workers()),
"ecosystems": len(EcosystemRegistry.ECOSYSTEMS),
})
if p == "/api/v1/cost/estimate":
q = urllib.parse.parse_qs(u.query)
dur = float(q.get("duration_sec", ["60"])[0])
arch = q.get("arch", ["x86_64"])[0]
return self._json(200, {"arch": arch, "duration_sec": dur, "costs": CostOptimizer.compare_modes(dur, arch)})
return self._json(404, {"error": "not_found"})

def do_POST(self):
u = urllib.parse.urlparse(self.path)
p = u.path
data = self._read_json()
if p == "/api/v1/build":
project = data.get("project_path") or ""
eco = data.get("ecosystem") or ""
if not project or not eco:
return self._json(400, {"error": "missing project_path/ecosystem"})
rid = str(uuid.uuid4())[:12]
req = BuildRequest(
id=rid,
project_path=project,
ecosystem=eco,
mode=data.get("mode", "local"),
target=data.get("target", "default"),
arch=data.get("arch", "x86_64"),
env=data.get("env", {}),
priority=int(data.get("priority", 5)),
timeout_sec=int(data.get("timeout_sec", 1800)),
clean=bool(data.get("clean", False)),
parallel=int(data.get("parallel", 0)),
verbose=bool(data.get("verbose", False)),
cache=bool(data.get("cache", True)),
security_scan=bool(data.get("security_scan", True)),
created_at=datetime.datetime.now(datetime.timezone.utc).isoformat(),
)
fut = ENGINE.submit(req)
try:
res = fut.result(timeout=req.timeout_sec + 30)
return self._json(200, asdict(res))
except concurrent.futures.TimeoutError:
return self._json(202, {"id": rid, "status": "running"})
if p == "/api/v1/build/batch":
items = data.get("items", [])
if not isinstance(items, list) or not items:
return self._json(400, {"error": "items must be non-empty list"})
reqs: List[BuildRequest] = []
for it in items:
rid = str(uuid.uuid4())[:12]
reqs.append(BuildRequest(
id=rid,
project_path=it.get("project_path", ""),
ecosystem=it.get("ecosystem", ""),
mode=it.get("mode", "local"),
arch=it.get("arch", "x86_64"),
env=it.get("env", {}),
timeout_sec=int(it.get("timeout_sec", 1800)),
cache=bool(it.get("cache", True)),
security_scan=bool(it.get("security_scan", True)),
created_at=datetime.datetime.now(datetime.timezone.utc).isoformat(),
))
futs = ENGINE.submit_batch(reqs)
ids = [r.id for r in reqs]
return self._json(202, {"submitted": ids})
if p == "/api/v1/workers/scale":
target = int(data.get("target", 2))
POOL.auto_scale(target)
return self._json(200, {"workers": [asdict(w) for w in POOL.list_workers()]})
if p == "/api/v1/cache/lookup":
key = data.get("key", "")
path = CACHE.lookup(key)
return self._json(200, {"key": key, "hit": bool(path), "path": path or ""})
if p == "/api/v1/cache/store":
key = data.get("key", "")
src = data.get("path", "")
stored = CACHE.store(key, src)
return self._json(200, {"key": key, "stored": stored})
if p == "/api/v1/security/scan":
project = data.get("project_path", "")
build_id = data.get("build_id", str(uuid.uuid4())[:12])
findings = SEC.scan(build_id, project)
for f in findings:
DB.save_finding(f)
return self._json(200, {"build_id": build_id, "count": len(findings), "findings": [asdict(f) for f in findings]})
return self._json(404, {"error": "not_found"})


class ThreadedServer(ThreadingHTTPServer):
daemon_threads = True
allow_reuse_address = True


