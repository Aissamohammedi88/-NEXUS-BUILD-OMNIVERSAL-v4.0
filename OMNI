("Bearer Token", r"(?i)bearer\s+[A-Za-z0-9\-_\.=]{20,}", Severity.HIGH.value, "Revoquer le bearer"),
("JDBC URL with creds", r"jdbc:[a-z]+://[^:]+:[^@]+@[^\s]+", Severity.CRITICAL.value, "Utiliser des variables d'environnement"),
("Postgres URL", r"postgres(?:ql)?://[^:]+:[^@]+@[^\s]+", Severity.CRITICAL.value, "Retirer les creds du code"),
("MySQL URL", r"mysql://[^:]+:[^@]+@[^\s]+", Severity.CRITICAL.value, "Retirer les creds du code"),
("MongoDB URL", r"mongodb(\+srv)?://[^:]+:[^@]+@[^\s]+", Severity.CRITICAL.value, "Retirer les creds du code"),
("Redis URL", r"redis://[^:]*:[^@]+@[^\s]+", Severity.HIGH.value, "Retirer les creds du code"),
]

COMPILED_SEC = [(n, re.compile(p), s, r) for n, p, s, r in SECURITY_PATTERNS]


class SecurityScanner:
"""Scanner basique de secrets et patterns sensibles."""

def __init__(self, max_file_size: int = 5 * 1024 * 1024):
self.max_file_size = max_file_size
self.text_exts = {
".py", ".java", ".kt", ".scala", ".rs", ".go", ".rb", ".php", ".js", ".ts",
".jsx", ".tsx", ".cs", ".swift", ".m", ".mm", ".c", ".h", ".cpp", ".hpp",
".sh", ".bash", ".zsh", ".ps1", ".yaml", ".yml", ".json", ".toml", ".ini",
".cfg", ".conf", ".env", ".properties", ".gradle", ".xml", ".tf", ".ex", ".exs",
".erl", ".hrl", ".lua", ".pl", ".r", ".jl", ".dart", ".nim", ".zig", ".hs", ".ml",
}

def scan(self, build_id: str, project_path: str) -> List[SecurityFinding]:
findings: List[SecurityFinding] = []
p = Path(project_path)
if not p.exists():
return findings
files = [p] if p.is_file() else [f for f in p.rglob("*") if f.is_file()]
for f in files:
try:
if f.stat().st_size > self.max_file_size:
continue
if f.suffix.lower() not in self.text_exts and f.name not in (".env", "Dockerfile", "Makefile"):
continue
content = f.read_text(encoding="utf-8", errors="ignore")
except OSError:
continue
lines = content.splitlines()
for idx, line in enumerate(lines, 1):
for name, rx, sev, reco in COMPILED_SEC:
m = rx.search(line)
if m:
snippet = line.strip()[:200]
value = m.group(0)
masked = value[:6] + "..." + value[-4:] if len(value) > 12 else value[:6] + "..."
findings.append(SecurityFinding(
id=str(uuid.uuid4())[:12],
build_id=build_id,
severity=sev,
kind=name,
file=str(f),
line=idx,
snippet=snippet.replace(value, masked),
recommendation=reco,
))
return findings


