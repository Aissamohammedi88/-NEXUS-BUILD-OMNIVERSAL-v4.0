class CostOptimizer:
"""Estimation de coût basique d'un build."""

HOURLY_RATES = {
"local": 0.0,
"distributed": 0.05,
"cloud": 0.25,
"hybrid": 0.12,
}

@classmethod
def estimate(cls, mode: str, duration_sec: float, arch: str) -> float:
rate = cls.HOURLY_RATES.get(mode, 0.05)
hours = duration_sec / 3600.0
multiplier = 1.0
if arch == Architecture.ARM64.value:
multiplier = 0.9
elif arch == Architecture.RISCV64.value:
multiplier = 1.2
elif arch == Architecture.WASM.value:
multiplier = 0.5
return round(rate * hours * multiplier, 6)

@classmethod
def compare_modes(cls, duration_sec: float, arch: str) -> Dict[str, float]:
return {mode: cls.estimate(mode, duration_sec, arch) for mode in cls.HOURLY_RATES}


